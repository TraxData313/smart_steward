<Project Sdk="Microsoft.NET.Sdk">

  <!-- Out-of-game check of the MCM bridge (src\SmartSteward.Module\McmBridge.cs): drives MCM's REAL
       fluent builder with the built SmartSteward.dll's McmDefaults / McmGroup - no game, no MCM service
       container - and checks the page (groups, controls, types, ids, hints), the live binding both ways,
       the dropdowns and the Default preset. Not in the solution. After a Release build of the solution,
       run this project in Release (dotnet run, project option = tools\McmProbe). Exit 0 = every check
       passed. Paths come from Directory.Build.props (GameFolder, McmBinFolder); Harmony (MCM's own
       dependency) defaults to its Workshop folder beside MCM's. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ModuleBin>$(MSBuildThisFileDirectory)..\..\src\SmartSteward.Module\bin\$(Configuration)</ModuleBin>
    <HarmonyBinFolder Condition="'$(HarmonyBinFolder)' == ''">$(McmBinFolder)\..\..\..\2859188632\bin\Win64_Shipping_Client</HarmonyBinFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="MCMv5">
      <HintPath>$(McmBinFolder)\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmartSteward.Core">
      <HintPath>$(ModuleBin)\SmartSteward.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ModuleBin</_Parameter1>
      <_Parameter2>$(ModuleBin)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GameBin</_Parameter1>
      <_Parameter2>$(GameFolder)\bin\Win64_Shipping_Client</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>McmBin</_Parameter1>
      <_Parameter2>$(McmBinFolder)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HarmonyBin</_Parameter1>
      <_Parameter2>$(HarmonyBinFolder)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
