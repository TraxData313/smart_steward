<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic: no game references, no packages. Everything here is unit-tested in
       tests\SmartSteward.Core.Tests; the Module feeds it snapshots of the game. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>SmartSteward.Core</RootNamespace>
    <AssemblyName>SmartSteward.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests reach the plan's internals (e.g. PlanTotals.Compute for the floor flags). -->
    <InternalsVisibleTo Include="SmartSteward.Core.Tests" />
  </ItemGroup>

</Project>
